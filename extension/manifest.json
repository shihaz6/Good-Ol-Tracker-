{
  "manifest_version": 3,
  "name": "Good ol Tracker",
  "version": "0.2.0",
  "description": "Sends active-tab time and summaries of a few allowlisted pages to the local Good ol Tracker app. Nothing leaves this PC.",
  "permissions": ["tabs", "idle", "alarms", "storage", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:47321/*",
    "https://www.youtube.com/*",
    "https://medium.com/*",
    "https://*.medium.com/*",
    "https://www.reddit.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html"
}
