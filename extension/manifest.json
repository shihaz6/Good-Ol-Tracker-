{
  "manifest_version": 3,
  "name": "Good ol Tracker",
  "version": "0.4.0",
  "description": "Sends active-tab time, scroll depth, your searches and page content summaries to the local Good ol Tracker app. Nothing leaves this PC.",
  "permissions": ["tabs", "idle", "alarms", "storage", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:47321/*",
    "https://www.youtube.com/*",
    "https://medium.com/*",
    "https://*.medium.com/*",
    "https://www.reddit.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Good ol Tracker" },
  "options_page": "options.html"
}
