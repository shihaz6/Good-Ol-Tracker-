{
  "manifest_version": 3,
  "name": "Good ol Tracker",
  "version": "0.6.1",
  "description": "Sends active-tab time, scroll depth, your searches and page content summaries to the local Good ol Tracker app, and blocks distracting sites during focus sessions. Nothing leaves this PC.",
  "permissions": ["tabs", "idle", "alarms", "storage", "scripting", "declarativeNetRequest", "notifications"],
  "host_permissions": [
    "http://127.0.0.1:47321/*",
    "https://www.youtube.com/*",
    "https://medium.com/*",
    "https://*.medium.com/*",
    "https://www.reddit.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Good ol Tracker" },
  "options_page": "options.html",
  "icons": { "128": "icon128.png" },
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["http://*/*", "https://*/*"] }]
}
