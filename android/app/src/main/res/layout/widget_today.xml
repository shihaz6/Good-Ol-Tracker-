<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone today"
                android:textColor="#FF9AA3B2"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/w_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="–"
                android:textColor="#FFE8EAF0"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_unlocks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF9AA3B2"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Productive"
                android:textColor="#FF9AA3B2"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/w_pc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="–"
                android:textColor="#FF6EA8FE"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_goals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF9AA3B2"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_focus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_button"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="Start 25-min focus"
        android:textColor="#FF07162E"
        android:textStyle="bold"
        android:textSize="14sp" />
</LinearLayout>
